    "code": "def solution():\n    # Define variables\n    coupon_rate = 0.03\n    yield_to_maturity = 0.05\n    years_to_maturity = 9\n    dirty_price = 85.784357\n    par_value = 100\n\n    annual_coupon = coupon_rate * par_value\n\n    # Calculate Macaulay duration from the bond's cash flows\n    weighted_present_value = 0.0\n    for year in range(1, years_to_maturity + 1):\n        cash_flow = annual_coupon\n        if year == years_to_maturity:\n            cash_flow += par_value\n\n        present_value = cash_flow / (1 + yield_to_maturity) ** year\n        weighted_present_value += year * present_value\n\n    macaulay_duration = weighted_present_value / dirty_price\n\n    # Convert Macaulay duration to modified duration\n    modified_duration = macaulay_duration / (1 + yield_to_maturity)\n\n    # Calculate price value of a basis point\n    pvbp = modified_duration * dirty_price * 0.0001\n\n    # Return the answer to three decimal places\n    return round(pvbp, 3)\n"
