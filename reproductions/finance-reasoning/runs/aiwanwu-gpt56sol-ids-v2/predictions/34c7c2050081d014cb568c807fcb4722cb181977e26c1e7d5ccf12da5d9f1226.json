    "code": "def solution():\n    # Define variables name and value\n    starting_assets = 160.0\n    growth_rate = 0.25\n    management_fee_rate = 0.02\n    performance_fee_rate = 0.20\n    hurdle_rate = 0.10\n    high_water_mark = 198.0\n\n    # Do math calculation to get the answer\n    end_year_assets = starting_assets * (1 + growth_rate)\n    management_fee = end_year_assets * management_fee_rate\n\n    # The soft hurdle is satisfied, but the net asset value remains below\n    # the prior high-water mark, so no incentive fee is collected.\n    net_assets_after_management_fee = end_year_assets - management_fee\n    hurdle_value = starting_assets * (1 + hurdle_rate)\n\n    if net_assets_after_management_fee > high_water_mark and net_assets_after_management_fee > hurdle_value:\n        performance_fee = (\n            net_assets_after_management_fee - high_water_mark\n        ) * performance_fee_rate\n    else:\n        performance_fee = 0.0\n\n    total_fees = management_fee + performance_fee\n\n    # return answer\n    return round(total_fees, 1)\n"
