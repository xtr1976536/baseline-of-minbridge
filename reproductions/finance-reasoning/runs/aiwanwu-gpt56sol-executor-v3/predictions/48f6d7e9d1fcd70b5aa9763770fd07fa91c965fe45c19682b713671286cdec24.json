    "code": "def solution():\n    current_prices = [150, 152, 151, 153, 155]\n    prior_prices = [148, 149, 150, 151, 152]\n    period1 = 25\n    period2 = 13\n\n    price_changes = [\n        current - prior\n        for current, prior in zip(current_prices, prior_prices)\n    ]\n    absolute_price_changes = [abs(change) for change in price_changes]\n\n    def calculate_ema(values, period):\n        multiplier = 2 / (period + 1)\n        ema = values[0]\n        for value in values[1:]:\n            ema = (value - ema) * multiplier + ema\n        return ema\n\n    first_ema = [calculate_ema(price_changes[:i + 1], period1)\n                 for i in range(len(price_changes))]\n    absolute_first_ema = [\n        calculate_ema(absolute_price_changes[:i + 1], period1)\n        for i in range(len(absolute_price_changes))\n    ]\n\n    double_ema = calculate_ema(first_ema, period2)\n    absolute_double_ema = calculate_ema(absolute_first_ema, period2)\n    tsi = (double_ema / absolute_double_ema) * 100\n\n    return round(tsi, 2)\n"
