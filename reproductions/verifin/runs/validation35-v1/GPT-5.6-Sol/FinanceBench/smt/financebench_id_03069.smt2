(declare-fun operand_0 () Real)
(declare-fun filing_depreciation_and_amortization () Bool)
(declare-fun operand_1 () Real)
(declare-fun filing_net_revenue () Bool)
(declare-fun domain_0 () Bool)
(declare-fun expected_value () Real)
(declare-fun authorized_formula () Bool)
(declare-fun claim_lower_bound () Bool)
(declare-fun claim_upper_bound () Bool)
(assert (=> filing_depreciation_and_amortization (= 167.0 operand_0)))
(assert (=> filing_net_revenue (= 3991.0 operand_1)))
(assert (=> domain_0 (distinct operand_1 0.0)))
(assert (=> authorized_formula (= expected_value (* (/ operand_0 operand_1) 100.0))))
(assert (=> claim_lower_bound
    (>= (/ 1.0 200.0) (- expected_value (/ 836883.0 200000.0)))))
(assert (=> claim_upper_bound
    (>= (/ 1.0 200.0) (- (/ 836883.0 200000.0) expected_value))))

(assert filing_depreciation_and_amortization)
(assert filing_net_revenue)
(assert domain_0)
(assert authorized_formula)
(assert claim_lower_bound)
(assert claim_upper_bound)
(check-sat)
