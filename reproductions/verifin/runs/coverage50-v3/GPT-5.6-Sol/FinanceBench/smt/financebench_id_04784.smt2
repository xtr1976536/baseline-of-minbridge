(declare-fun operand_0 () Real)
(declare-fun filing_operating_income_end () Bool)
(declare-fun operand_1 () Real)
(declare-fun filing_operating_income_start () Bool)
(declare-fun operand_2 () Real)
(declare-fun filing_revenue_end () Bool)
(declare-fun operand_3 () Real)
(declare-fun filing_revenue_start () Bool)
(declare-fun domain_0 () Bool)
(declare-fun domain_1 () Bool)
(declare-fun expected_value () Real)
(declare-fun authorized_formula () Bool)
(declare-fun claim_lower_bound () Bool)
(declare-fun claim_upper_bound () Bool)
(assert (=> filing_operating_income_end (= 21957.0 operand_0)))
(assert (=> filing_operating_income_start (= 20437.0 operand_1)))
(assert (=> filing_revenue_end (= 514405.0 operand_2)))
(assert (=> filing_revenue_start (= 500343.0 operand_3)))
(assert (=> domain_0 (distinct operand_2 0.0)))
(assert (=> domain_1 (distinct operand_3 0.0)))
(assert (let ((a!1 (= expected_value
              (- (* (/ operand_0 operand_2) 100.0)
                 (* (/ operand_1 operand_3) 100.0)))))
  (=> authorized_formula a!1)))
(assert (=> claim_lower_bound (>= (/ 1.0 20.0) (- expected_value (/ 1.0 5.0)))))
(assert (=> claim_upper_bound (>= (/ 1.0 20.0) (- (/ 1.0 5.0) expected_value))))

(assert filing_operating_income_end)
(assert filing_operating_income_start)
(assert filing_revenue_end)
(assert filing_revenue_start)
(assert domain_0)
(assert domain_1)
(assert authorized_formula)
(assert claim_lower_bound)
(assert claim_upper_bound)
(check-sat)
