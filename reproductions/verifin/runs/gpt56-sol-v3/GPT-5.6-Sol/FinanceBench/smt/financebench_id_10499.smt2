(declare-fun operand_0 () Real)
(declare-fun filing_cost_of_revenue () Bool)
(declare-fun operand_1 () Real)
(declare-fun filing_inventory_end () Bool)
(declare-fun operand_2 () Real)
(declare-fun filing_inventory_start () Bool)
(declare-fun domain_0 () Bool)
(declare-fun domain_1 () Bool)
(declare-fun expected_value () Real)
(declare-fun authorized_formula () Bool)
(declare-fun claim_lower_bound () Bool)
(declare-fun claim_upper_bound () Bool)
(assert (=> filing_cost_of_revenue (= 16830000000.0 operand_0)))
(assert (=> filing_inventory_end (= 2721000000.0 operand_1)))
(assert (=> filing_inventory_start (= 2667000000.0 operand_2)))
(assert (=> domain_0 (distinct 2.0 0.0)))
(assert (=> domain_1 (distinct (/ (+ operand_2 operand_1) 2.0) 0.0)))
(assert (let ((a!1 (= expected_value (/ operand_0 (/ (+ operand_2 operand_1) 2.0)))))
  (=> authorized_formula a!1)))
(assert (=> claim_lower_bound (>= (/ 1.0 200.0) (- expected_value (/ 25.0 4.0)))))
(assert (=> claim_upper_bound (>= (/ 1.0 200.0) (- (/ 25.0 4.0) expected_value))))

(assert filing_cost_of_revenue)
(assert filing_inventory_end)
(assert filing_inventory_start)
(assert domain_0)
(assert domain_1)
(assert authorized_formula)
(assert claim_lower_bound)
(assert claim_upper_bound)
(check-sat)
