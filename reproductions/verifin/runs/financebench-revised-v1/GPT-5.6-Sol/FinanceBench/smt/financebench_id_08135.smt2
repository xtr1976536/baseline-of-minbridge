(declare-fun operand_0 () Real)
(declare-fun filing_revenue_2016 () Bool)
(declare-fun operand_1 () Real)
(declare-fun filing_revenue_2017 () Bool)
(declare-fun domain_0 () Bool)
(declare-fun expected_value () Real)
(declare-fun authorized_formula () Bool)
(declare-fun claim_lower_bound () Bool)
(declare-fun claim_upper_bound () Bool)
(assert (=> filing_revenue_2016 (= 135987.0 operand_0)))
(assert (=> filing_revenue_2017 (= 177866.0 operand_1)))
(assert (=> domain_0 (distinct operand_0 0.0)))
(assert (let ((a!1 (= expected_value (* (/ (- operand_1 operand_0) operand_0) 100.0))))
  (=> authorized_formula a!1)))
(assert (=> claim_lower_bound (>= (/ 1.0 20.0) (- expected_value (/ 154.0 5.0)))))
(assert (=> claim_upper_bound (>= (/ 1.0 20.0) (- (/ 154.0 5.0) expected_value))))

(assert filing_revenue_2016)
(assert filing_revenue_2017)
(assert domain_0)
(assert authorized_formula)
(assert claim_lower_bound)
(assert claim_upper_bound)
(check-sat)
